# ------------------------------------------------------------------------------
data/raw/
data/raw_policies/
data/confidential/
data/contracts/
data/customer_data/
data/uploads/
data/temp/

# Raw policy file extensions (unprocessed enterprise documents)
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.csv
*.tsv

# Allow committed sample / canonical data strictly used for tests and reference
!data/sample/
!data/sample/**
!data/canonical/
!data/canonical/**
!data/benchmark/
!data/benchmark/**

