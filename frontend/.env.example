# Sao chép thành .env.local rồi chỉnh. Đổi mock ↔ backend thật KHÔNG cần sửa code màn hình.

# mock — MSW chặn request trong trình duyệt, backend giả lập đầy đủ (mặc định)
# real — gọi FastAPI thật
NEXT_PUBLIC_API_MODE=mock

# Base URL của API. Để /api/v1 khi chạy `npm run dev` (Vite proxy chuyển tiếp, không cần CORS);
# hoặc URL tuyệt đối khi deploy, ví dụ https://api.pricepolicy.vn/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Đích proxy của Vite dev server cho /api/* (chỉ dùng với `npm run dev`, không lộ ra trình duyệt).
API_PROXY_TARGET=http://localhost:8000
