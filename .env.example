# ============================================================
# PricePolicy AI Agent — Environment Variables (theo TD-4.1)
# ============================================================
# Copy file này thành .env và điền giá trị thật:
#   cp .env.example .env
# KHÔNG BAO GIỜ commit .env lên git!
#
# Quy ước: biến COMMENTED (#) = tùy chọn, bật khi cần dùng.

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ---- Khoá mã hoá API key của nhà cung cấp LLM (Admin khai báo trên giao diện) ----
# Đặt chuỗi ngẫu nhiên >= 32 ký tự. Khoá API trong DB được mã hoá bằng khoá này (Fernet + HMAC);
# nếu để trống, mã nguồn dùng khoá mặc định của bản dev — KHÔNG an toàn cho production.
# Lưu ý: đổi giá trị này thì phải vào màn hình quản trị nhập lại API key (nếu không, hệ thống vẫn
# chạy được nhờ đường lùi nhưng sẽ ghi cảnh báo yêu cầu nhập lại).
LLM_SECRET_KEY=

# ---- Chế độ header khi gọi nhà cung cấp LLM ----
# app     = khai báo tên ứng dụng (mặc định; hợp lệ với hầu hết nhà cung cấp)
# browser = gửi thêm header kiểu trình duyệt — CHỈ bật khi nhà cung cấp đứng sau Cloudflare luôn trả
#           trang "Just a moment..." cho máy chủ. Bật xong phải deploy lại (git up --force) rồi Test lại.
LLM_HTTP_HEADERS=app
# IP công khai của máy chủ — điền sẵn thì thông báo lỗi Cloudflare khỏi phải tra tự động (tuỳ chọn).
# LLM_PUBLIC_IP=

# ---- Primary LLM (N-13 giải trình, C-09 pre-sales chat) ----
# Điền khoá thật ở đây, HOẶC (khuyến nghị) để trống rồi khai báo trong màn hình quản trị →
# "Nhà cung cấp LLM" (khoá trong DB thắng ENV, được mã hoá và che khi hiển thị).
# LƯU Ý: trước đây dòng này có sẵn giá trị mẫu `sk-your-...`; ai `cp .env.example .env` mà không sửa thì
# hệ thống báo "Đã có khoá" dù chưa cung cấp khoá nào. Nay để TRỐNG và mọi giá trị mẫu đều bị bỏ qua.
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=1

# ---- Fallback LLM 1 (Tự động chuyển tiếp khi Primary lỗi/rate limit) ----
# FALLBACK1_OPENAI_API_KEY=
# FALLBACK1_OPENAI_BASE_URL=https://api.deepseek.com/v1
# FALLBACK1_MODEL_NAME=deepseek-chat

# ---- Fallback LLM 2 (Lưới an toàn thứ hai) ----
# FALLBACK2_OPENAI_API_KEY=
# FALLBACK2_OPENAI_BASE_URL=
# FALLBACK2_MODEL_NAME=gpt-4o-mini

# ---- Đọc câu trả lời thành tiếng (TTS) ----
# Cách khuyến nghị: để TRỐNG các khoá dưới đây và khai báo trong màn hình quản trị →
# "Giọng đọc (TTS)" (khoá trong DB thắng ENV, được mã hoá và che khi hiển thị). ENV là đường lui cho
# triển khai không dùng giao diện.
# OPENAI_API_KEY dùng CHUNG với LLM ở trên (không khai lại).
# GOOGLE_APPLICATION_CREDENTIALS=
# AZURE_SPEECH_KEY=
# VIETTEL_TTS_TOKEN=
# VBEE_TOKEN=
# FPT_TTS_API_KEY=
# Hạn mức ký tự gửi đi đọc mỗi ngày cho đường trả phí (0 = không giới hạn). Vượt hạn mức thì
# giao diện tự lùi về giọng trình duyệt (0 đồng) — tránh "cháy" ngân sách do một phiên bị lặp.
TTS_DAILY_CHAR_BUDGET=300000

# ---- LangSmith (AI Logs — Deliverable #4, bắt buộc cho grading) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Database: Supabase PostgreSQL 16 (TD-4.2 — C-02/C-03/C-07) ----
# Driver async: postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgresql+asyncpg://postgres:password@db.<ref>.supabase.co:5432/postgres
# Checkpoint DB cho LangGraph persistent state (driver sync / psycopg2)
CHECKPOINT_DB_URI=postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres
USE_POSTGRES_CHECKPOINTER=true
# Fallback DNS cho Supabase pooler khi mạng trường học/công ty chặn phân giải CNAME AWS (mặc định true).
# Patch đổi socket.getaddrinfo của toàn tiến trình và chỉ kích hoạt nếu DATABASE_URL trỏ tới Supabase.
DB_DNS_FALLBACK=true
# IP dự phòng khi cả DNS hệ thống lẫn DNS-over-HTTPS đều thất bại (AWS đổi dải IP thì cập nhật ở đây,
# không cần sửa code). Để trống = dùng danh sách mặc định trong src/db/dns_patch.py.
# DB_DNS_STATIC_IPS=13.124.111.232,15.164.120.176
# DB_DNS_STATIC_HOST=aws-0-ap-northeast-2.pooler.supabase.com

# Supabase Storage / Auth (Tùy chọn)
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# ---- pgvector / Embeddings & Semantic Search (C-02) ----
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
RERANKER_TOP_K=5
HYBRID_SEARCH_ENABLED=true
COARSE_TOP_K=30
CHROMA_PERSIST_DIR=./data/chroma

# ---- Pricing Sidecar (Component C-06: Deterministic Financial Engine) ----
PRICING_SIDECAR_SOCKET=./data/pricing.sock
PRICING_SIDECAR_HOST=127.0.0.1
PRICING_SIDECAR_PORT=28001
PRICING_USE_MOCK=false
PRICING_FALLBACK_TO_DIRECT=true

# ---- Nguồn dữ liệu (CSDL thật là mặc định) ----
# BẮT BUỘC để TẮT/false trên mọi môi trường chạy thật: khi đó giỏ hàng, chính sách, chứng cứ báo giá
# chỉ đọc PostgreSQL. Fixture canonical (POLICIES_DATA/UNITS_DATA) chỉ là dữ liệu test/demo offline.
ALLOW_FIXTURE_DATA=false

# ---- Ký số & HITL Approval (C-05: KMS Ed25519 server attestation) ----
# KMS_ED25519_SEED=
# SIGNING_KMS_URL=
# SIGNING_KEY_ID=

# ---- Pre-Sales (C-09: TTL phiên chat công khai — Spike 5) ----
PRE_SALES_SESSION_TTL_MINUTES=60

# ---- Frontend (Vite Single Origin / API Client) ----
# Luôn luôn kết nối Backend & CSDL PostgreSQL thật (không mock)
NEXT_PUBLIC_API_MODE=real
# Localhost tự động trỏ tới http://localhost:8000/api/v1. Trên VPS trỏ tới /api/v1 (Nginx proxy)
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# ---- AI Hook Logging (Hệ thống chấm điểm Phoenix của BTC) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log
