# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Primary LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=1

# OpenAI-Compatible Base URL (Optional — for DeepSeek, Groq, OpenRouter, Ollama, vLLM, etc.)
# Leave blank or commented out to use official OpenAI endpoint
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://localhost:11434/v1

# ---- Fallback LLM 1 (Optional: Auto-switches when Primary hits rate limit/error) ----
# FALLBACK_OPENAI_API_KEY=your-fallback-key-here
# FALLBACK_OPENAI_BASE_URL=https://api.deepseek.com/v1
# FALLBACK_MODEL_NAME=deepseek-chat

# ---- Fallback LLM 2 (Optional: Second safety net) ----
# FALLBACK2_OPENAI_API_KEY=your-fallback2-key-here
# FALLBACK2_OPENAI_BASE_URL=
# FALLBACK2_MODEL_NAME=gpt-4o-mini

# Or use other native providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Fallback LLM 1 (Optional: Auto-switches when Primary hits rate limit/error) ----
# FALLBACK_OPENAI_API_KEY=your-fallback-key-here
# FALLBACK_OPENAI_BASE_URL=https://api.deepseek.com/v1
# FALLBACK_MODEL_NAME=deepseek-chat

# ---- Fallback LLM 2 (Optional: Second safety net) ----
# FALLBACK2_OPENAI_API_KEY=your-fallback2-key-here
# FALLBACK2_OPENAI_BASE_URL=
# FALLBACK2_MODEL_NAME=gpt-4o-mini

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
