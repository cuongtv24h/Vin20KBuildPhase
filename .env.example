# ============================================================
# PricePolicy AI Agent — Environment Variables (theo TD-4.1)
# ============================================================
# Copy file này thành .env và điền giá trị thật:
#   cp .env.example .env
# KHÔNG BAO GIỜ commit .env lên git!
#
# Quy ước: biến COMMENTED = chưa bắt buộc ở giai đoạn hiện tại,
# bật dần khi implement component tương ứng (mã C-xx trong ngoặc).

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Primary LLM (N-13 giải trình, C-09 pre-sales chat) ----
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=1
# OPENAI_BASE_URL=              # OpenAI-compatible: Groq / DeepSeek / OpenRouter / vLLM

# ---- Fallback LLM 1 (Optional: auto-switch khi primary lỗi/rate limit) ----
# FALLBACK_OPENAI_API_KEY=
# FALLBACK_OPENAI_BASE_URL=https://api.deepseek.com/v1
# FALLBACK_MODEL_NAME=deepseek-chat

# ---- Fallback LLM 2 (Optional: lưới an toàn thứ hai) ----
# FALLBACK2_OPENAI_API_KEY=
# FALLBACK2_OPENAI_BASE_URL=
# FALLBACK2_MODEL_NAME=gpt-4o-mini

# ---- LangSmith (AI Logs — Deliverable #4, bắt buộc cho grading) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Database: Supabase PostgreSQL 16 (TD-4.2 — C-02/C-03/C-07) ----
# Lưu ý driver async: postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.<ref>.supabase.co:5432/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=    # CHỈ dùng server-side, không bao giờ lộ ra frontend
# SUPABASE_ANON_KEY=            # nếu cần truy cập read-only từ client

# ---- pgvector / Embeddings (C-02: time-travel semantic search) ----
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- Redis / Outbox Worker (C-01: PDF + SSE dispatch qua ARQ — src/worker/) ----
# REDIS_URL=redis://localhost:6379/0

# ---- Pricing Sidecar (C-06: Math Engine tất định qua Unix Domain Socket) ----
# Dev: ./data/pricing.sock — Production: /var/run/pricing/engine.sock
PRICING_SIDECAR_SOCKET=./data/pricing.sock

# ---- Ký số & HITL Approval (C-05: KMS Ed25519 server attestation) ----
# Private key CHỈ nằm ở KMS — app chỉ gửi payload hash (N-19A/N-19B)
# SIGNING_KMS_URL=
# SIGNING_KEY_ID=

# ---- Object Storage (PDF báo giá + canonical snapshots) ----
# Chọn Supabase Storage HOẶC S3-compatible
# SUPABASE_STORAGE_BUCKET=quote-pdfs
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Pre-Sales (C-09: TTL phiên chat công khai — Spike 5) ----
PRE_SALES_SESSION_TTL_MINUTES=60

# ---- Frontend (Next.js — Dev 3) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- AI Hook Logging (của BTC — KHÔNG đổi tên biến) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log
