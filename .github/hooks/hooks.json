{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "bash scripts/ai_log/_pyrun.sh scripts/ai_log/log_hook.py --tool=copilot",
        "powershell": "scripts\\ai_log\\_pyrun.cmd scripts\\ai_log\\log_hook.py --tool=copilot",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "bash scripts/ai_log/_pyrun.sh scripts/ai_log/log_hook.py --tool=copilot",
        "powershell": "scripts\\ai_log\\_pyrun.cmd scripts\\ai_log\\log_hook.py --tool=copilot",
        "timeoutSec": 10
      }
    ]
  }
}
