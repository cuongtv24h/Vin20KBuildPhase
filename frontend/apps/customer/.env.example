# Sao chép thành .env.local rồi chỉnh. Đổi mock ↔ backend thật KHÔNG cần sửa code màn hình.

# mock (mặc định) — gọi packages/mock-server (giả lập đầy đủ, chạy `npm run dev:mock` ở root)
# real — gọi FastAPI thật
NEXT_PUBLIC_API_MODE=mock

# URL tuyệt đối của API. Bắt buộc là URL đầy đủ (không dùng đường dẫn tương đối như /api/v1) vì
# UI Khách hàng (origin :5173) và API server là hai origin khác nhau — gọi qua CORS, không qua proxy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787/api/v1
