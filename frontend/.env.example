# Sao chép thành .env.local rồi chỉnh.

# mock  — backend giả lập trong trình duyệt (mặc định, không cần server)
# http  — gọi REST backend thật theo src/api/contracts.ts
VITE_API_MODE=mock

# Base URL của API khi VITE_API_MODE=http. Để "/api/v1" để dùng proxy của Vite dev server.
VITE_API_BASE_URL=/api/v1

# Đích proxy của Vite dev server cho mọi request /api/* (chỉ dùng khi chạy `npm run dev`).
VITE_API_PROXY_TARGET=http://localhost:8000
